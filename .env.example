# Port for the local dev server (server.js). Cloudflare Pages ignores this.
PORT=3000

# Resend API key — used to email intake submissions to the desk inbox.
# Production: set as an environment variable on the Cloudflare Pages project.
# Local dev: copy this file to `.env` and paste your key (never commit `.env`).
RESEND_API_KEY=

# Inbox that receives intake emails. Defaults to daftrify.services@gmail.com
# (same as production) when unset.
INTAKE_RECIPIENT=
