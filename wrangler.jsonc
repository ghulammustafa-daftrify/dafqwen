{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dafqwen",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "destination_address": "contact@daftrify.com",
      "allowed_sender_addresses": [
        "contact@daftrify.com"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
